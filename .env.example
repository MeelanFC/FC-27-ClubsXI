# ClubsXI settings. Copy this file to .env and fill in the values.
# docs/02-find-your-club-id.md tells you how to find a club id.

# REQUIRED. Your club ids, comma separated. Put the main club first.
CLUBSXI_CLUB_IDS=

# Optional. A practice club in the list above, if you have one.
CLUBSXI_PRACTICE_CLUB=

# Optional. The ids that count for this season. Default: all ids above.
# EA can give a club a new id when a new game year starts.
CLUBSXI_SEASON_CLUB_IDS=

# Optional. Unix time of the first game of this season. 0 = count all games.
CLUBSXI_SEASON_START=0

# Optional. An EA name that must be in every roster. "check" warns if not.
CLUBSXI_CHECK_PLAYER=

# Time zone for "one night of games" on the Scrims page. Default UTC.
# Example: America/Chicago, Europe/London.
CLUBSXI_TIMEZONE=UTC

# The values below already have good defaults.
CLUBSXI_PLATFORM=common-gen5
CLUBSXI_MATCH_TYPES=leagueMatch,friendlyMatch,playoffMatch
CLUBSXI_POLL_MINUTES=30
CLUBSXI_MAX_RESULT_COUNT=10
CLUBSXI_OPPONENT_HISTORY_CLUBS_PER_POLL=20
CLUBSXI_CALL_SPACING_SECONDS=2.0
CLUBSXI_WEB_PORT=8080

# Optional second copy of every raw response as files on disk.
# CLUBSXI_RAW_DUMP_DIR=/data/raw
